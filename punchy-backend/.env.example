# Copy to .env for local development. Never commit .env or production secrets.
DATABASE_URL="mongodb://127.0.0.1:27018/punchy?replicaSet=rs0&directConnection=true"
JWT_SECRET="generate-a-random-secret-at-least-32-characters"
JWT_REFRESH_SECRET="generate-another-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000,http://localhost:8080"
UPLOAD_DIR="./uploads"

# Configure these only through your secret manager in staging/production.
CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="support.punchy@gmail.com"
BREVO_SENDER_NAME="Punchy"
