// ─── Prisma Schema — Punchy Platform ───────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  BUSINESS
  ADMIN
  STAFF
}

enum BusinessStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum PunchMethodType {
  QR
  NFC
}

enum NotificationTarget {
  ALL
  BUSINESSES
  CUSTOMERS
  USER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

// Placeholder for future monetisation — no schema rework needed when introduced
enum SubscriptionTier {
  FREE
  PREMIUM
}

// ─── User ────────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  email         String   @unique
  name          String?
  phone         String?
  passwordHash  String
  role          Role     @default(CUSTOMER)
  isBlocked     Boolean  @default(false)
  isStaffActive Boolean  @default(true) // Controlled by parent business owner
  businessId    String?  @db.ObjectId   // Link for STAFF role to parent business
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  businessProfile   BusinessProfile?
  staffBusiness     BusinessProfile? @relation("BusinessStaff", fields: [businessId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customerCards     CustomerCard[]
  refreshTokens     RefreshToken[]
  sentNotifications Notification[]  @relation("NotificationCreator")
  supportTickets    SupportTicket[] @relation("TicketAuthor")
  resolvedTickets   SupportTicket[] @relation("TicketResolver")
  activityLogs      ActivityLog[]
}

model RefreshToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  token     String   @unique
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ─── Business ────────────────────────────────────────────────────────────────

model BusinessProfile {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  userId           String           @unique @db.ObjectId
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  logo             String?
  category         String
  description      String?
  website          String?
  status           BusinessStatus   @default(PENDING)
  subscriptionTier SubscriptionTier @default(FREE)
  locations        Json             @default("[]")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  loyaltyCards LoyaltyCard[]
  staffMembers User[]        @relation("BusinessStaff")
}

// ─── Loyalty Card ────────────────────────────────────────────────────────────

model LoyaltyCard {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId
  businessId        String          @db.ObjectId
  business          BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title             String
  punchesRequired   Int             @default(10)
  rewardDescription String
  visualStyle       Json            @default("{}")
  validUntil        DateTime?       // Validity expiration date
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  punchMethods  PunchMethod[]
  customerCards CustomerCard[]
}

// ─── Punch Method ─────────────────────────────────────────────────────────────

model PunchMethod {
  id         String          @id @default(auto()) @map("_id") @db.ObjectId
  cardId     String          @db.ObjectId
  card       LoyaltyCard     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  type       PunchMethodType
  identifier String          @unique
  label      String?
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())

  punchTransactions PunchTransaction[]
}

// ─── Customer Card (join + state) ────────────────────────────────────────────

model CustomerCard {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  customerId  String      @db.ObjectId
  customer    User        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  cardId      String      @db.ObjectId
  card        LoyaltyCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  punchCount  Int         @default(0)
  isCompleted Boolean     @default(false)
  joinedAt    DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  punchTransactions PunchTransaction[]
  redemptions       Redemption[]

  @@unique([customerId, cardId])
}

// ─── Punch Transaction ────────────────────────────────────────────────────────

model PunchTransaction {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  customerCardId String          @db.ObjectId
  customerCard   CustomerCard    @relation(fields: [customerCardId], references: [id], onDelete: Cascade)
  punchMethodId  String          @db.ObjectId
  punchMethod    PunchMethod     @relation(fields: [punchMethodId], references: [id])
  method         PunchMethodType
  timestamp      DateTime        @default(now())
}

// ─── Redemption ───────────────────────────────────────────────────────────────

model Redemption {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  customerCardId String       @db.ObjectId
  customerCard   CustomerCard @relation(fields: [customerCardId], references: [id], onDelete: Cascade)
  redeemedAt     DateTime     @default(now())
  verifiedBy     String?      @db.ObjectId
}

// ─── Notification ─────────────────────────────────────────────────────────────

model Notification {
  id          String             @id @default(auto()) @map("_id") @db.ObjectId
  targetType  NotificationTarget
  targetId    String?            @db.ObjectId
  title       String
  body        String
  sentAt      DateTime?
  scheduledAt DateTime?
  createdBy   String             @db.ObjectId
  creator     User               @relation("NotificationCreator", fields: [createdBy], references: [id])
  createdAt   DateTime           @default(now())
}

// ─── Support Ticket ───────────────────────────────────────────────────────────

model SupportTicket {
  id         String       @id @default(auto()) @map("_id") @db.ObjectId
  authorId   String       @db.ObjectId
  author     User         @relation("TicketAuthor", fields: [authorId], references: [id])
  subject    String
  body       String
  status     TicketStatus @default(OPEN)
  resolvedBy String?      @db.ObjectId
  resolver   User?        @relation("TicketResolver", fields: [resolvedBy], references: [id])
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?
  updatedAt  DateTime     @updatedAt
}

// ─── Admin Config ─────────────────────────────────────────────────────────────

model AdminConfig {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.ObjectId
}

// ─── Activity Log ─────────────────────────────────────────────────────────────

model ActivityLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
}
